# Variables para Coolify (Docker Compose → Environment Variables).
# No commitear valores reales. Copiar/pegar en la UI de Coolify.

# --- PostgreSQL (interno; hostname en Docker = postgres) ---
POSTGRES_USER=lrjas
POSTGRES_PASSWORD=cambia_esta_contraseña_larga
POSTGRES_DB=lrjas

# --- API ---
PORT=3001
JWT_SECRET=cambia_este_secreto_jwt
JWT_EXPIRES_IN=7d

# Origen CORS = URL exacta del front en Cloudflare Pages (sin / final)
FRONTEND_URL=https://lrjasmerida.me

# Admin inicial (si la BD no tiene usuarios; tras pg_dump puedes dejar SKIP_DB_SEED=1)
MASTER_USER_USERNAME=alan
MASTER_USER_NAME=Alan
MASTER_USER_PASSWORD=cambia_esta_contraseña_admin

# Tras restaurar backup: 1 | en BD nueva: 0
SKIP_DB_SEED=0

# --- Cloudflare Pages (build del frontend, no va en Coolify) ---
# VITE_API_URL=https://api.lrjas.onema.tech/api
