generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Sex {
  MALE
  FEMALE
}

enum FieldType {
  CHECKBOX
  TEXT
  SELECT
}

enum AttendanceMethod {
  QR
  MANUAL
}

enum Role {
  ADMIN
}

enum SocialPlatform {
  INSTAGRAM
  FACEBOOK
}

enum ParticipantType {
  MEMBER
  NON_MEMBER
  VISITOR
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
  CHANGES_REQUESTED
}

enum ResponsibleType {
  PRIMARY
  SECONDARY
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  CANCELLED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

model User {
  id        String   @id @default(uuid())
  username  String   @unique
  password  String
  name      String
  role      Role     @default(ADMIN)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("users")
}

model Stake {
  id           String        @id @default(uuid())
  name         String        @unique
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  wards        Ward[]
  participants Participant[]

  @@map("stakes")
}

model Ward {
  id           String        @id @default(uuid())
  name         String
  stakeId      String        @map("stake_id")
  stake        Stake         @relation(fields: [stakeId], references: [id])
  active       Boolean       @default(true)
  createdAt    DateTime      @default(now()) @map("created_at")
  participants Participant[]

  @@unique([name, stakeId])
  @@map("wards")
}

model FieldDefinition {
  id          String                  @id @default(uuid())
  name        String                  @unique
  label       String
  type        FieldType               @default(CHECKBOX)
  required    Boolean                 @default(false)
  active      Boolean                 @default(true)
  createdAt   DateTime                @default(now()) @map("created_at")
  fieldValues ParticipantFieldValue[]

  @@map("field_definitions")
}

model Participant {
  id             String                  @id @default(uuid())
  code           String                  @unique
  firstName      String                  @map("first_name")
  middleName     String?                 @map("middle_name")
  lastName       String                  @map("last_name")
  motherLastName String                  @map("mother_last_name")
  age            Int
  birthDate      DateTime                @map("birth_date") @db.Date
  sex            Sex
  type           ParticipantType         @default(MEMBER)
  visitorStake   String?                 @map("visitor_stake")
  city           String?
  state          String?
  stakeId        String                  @map("stake_id")
  stake          Stake                   @relation(fields: [stakeId], references: [id])
  wardId         String                  @map("ward_id")
  ward           Ward                    @relation(fields: [wardId], references: [id])
  active         Boolean                 @default(true)
  createdAt      DateTime                @default(now()) @map("created_at")
  updatedAt      DateTime                @updatedAt @map("updated_at")
  fieldValues    ParticipantFieldValue[]
  attendances    Attendance[]

  // Actividades / RBAC
  accessRoles              ParticipantAccessRole[]
  teamMemberships          TeamMember[]
  activitiesCreated        Activity[]              @relation("ActivityCreator")
  activitiesApproved       Activity[]              @relation("ActivityApprover")
  activityResponsibilities ActivityResponsible[]
  tasksAssigned            ActivityTask[]          @relation("TaskAssignee")
  tasksCompleted           ActivityTask[]          @relation("TaskCompleter")
  approvalRequestsMade     ApprovalRequest[]       @relation("ApprovalRequester")
  approvalReviews          ApprovalRequest[]       @relation("ApprovalReviewer")
  activityHistoryEntries   ActivityHistory[]
  notifications            Notification[]

  @@map("participants")
}

model ParticipantFieldValue {
  id            String          @id @default(uuid())
  participantId String          @map("participant_id")
  participant   Participant     @relation(fields: [participantId], references: [id], onDelete: Cascade)
  fieldId       String          @map("field_id")
  field         FieldDefinition @relation(fields: [fieldId], references: [id])
  value         Boolean         @default(false)

  @@unique([participantId, fieldId])
  @@map("participant_field_values")
}

model Attendance {
  id            String           @id @default(uuid())
  participantId String           @map("participant_id")
  participant   Participant      @relation(fields: [participantId], references: [id])
  eventId       String           @map("event_id")
  event         Event            @relation(fields: [eventId], references: [id])
  method        AttendanceMethod
  dateMexico    String           @map("date_mexico")
  createdAt     DateTime         @default(now()) @map("created_at")

  @@unique([participantId, dateMexico, eventId])
  @@index([dateMexico])
  @@index([eventId])
  @@map("attendances")
}

model Event {
  id          String       @id @default(uuid())
  name        String       @unique
  active      Boolean      @default(true)
  sortOrder   Int          @default(0) @map("sort_order")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  attendances Attendance[]

  @@map("events")
}

model SocialPost {
  id        String         @id @default(uuid())
  title     String
  postUrl   String         @map("post_url")
  platform  SocialPlatform @default(INSTAGRAM)
  active    Boolean        @default(true)
  featured  Boolean        @default(true)
  sortOrder Int            @default(0) @map("sort_order")
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")

  @@map("social_posts")
}

// ─────────────────────────────────────────────
// Módulo Actividades (RBAC + operaciones)
// Los actores son Participant (código 000–999).
// User/Role ADMIN siguen siendo el panel principal.
// ─────────────────────────────────────────────

model Permission {
  id          String           @id @default(uuid())
  key         String           @unique
  name        String
  description String?
  groupKey    String           @map("group_key")
  createdAt   DateTime         @default(now()) @map("created_at")
  roles       RolePermission[]

  @@index([groupKey])
  @@map("permissions")
}

/// Rol configurable del módulo de actividades (no confundir con enum Role de admins).
model AccessRole {
  id          String                 @id @default(uuid())
  name        String                 @unique
  description String?
  active      Boolean                @default(true)
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")
  permissions RolePermission[]
  participants ParticipantAccessRole[]

  @@map("access_roles")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  role         AccessRole @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model ParticipantAccessRole {
  participantId String      @map("participant_id")
  roleId        String      @map("role_id")
  assignedAt    DateTime    @default(now()) @map("assigned_at")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  role          AccessRole  @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([participantId, roleId])
  @@map("participant_access_roles")
}

model Team {
  id          String       @id @default(uuid())
  name        String       @unique
  description String?
  color       String       @default("#84bd31")
  active      Boolean      @default(true)
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  members     TeamMember[]
  activities  Activity[]

  @@map("teams")
}

model TeamMember {
  teamId        String      @map("team_id")
  participantId String      @map("participant_id")
  joinedAt      DateTime    @default(now()) @map("joined_at")
  team          Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@id([teamId, participantId])
  @@map("team_members")
}

model ActivityStatus {
  id         String     @id @default(uuid())
  name       String     @unique
  color      String     @default("#84bd31")
  position   Int        @default(0)
  isInitial  Boolean    @default(false) @map("is_initial")
  isFinal    Boolean    @default(false) @map("is_final")
  isActive   Boolean    @default(true) @map("is_active")
  createdAt  DateTime   @default(now()) @map("created_at")
  updatedAt  DateTime   @updatedAt @map("updated_at")
  activities Activity[]

  @@map("activity_statuses")
}

model Activity {
  id                  String         @id @default(uuid())
  name                String
  slug                String?        @unique
  publicDescription   String         @map("public_description") @db.Text
  internalDescription String?        @map("internal_description") @db.Text
  date                DateTime       @db.Date
  startTime           String         @map("start_time")
  endTime             String?        @map("end_time")
  location            String
  locationUrl         String?        @map("location_url")
  coverImageUrl       String?        @map("cover_image_url")
  teamId              String?        @map("team_id")
  team                Team?          @relation(fields: [teamId], references: [id])
  statusId            String         @map("status_id")
  status              ActivityStatus @relation(fields: [statusId], references: [id])
  approvalStatus      ApprovalStatus @default(PENDING) @map("approval_status")
  requiresBudget      Boolean        @default(false) @map("requires_budget")
  internalNotes       String?        @map("internal_notes") @db.Text
  createdById         String         @map("created_by_id")
  createdBy           Participant    @relation("ActivityCreator", fields: [createdById], references: [id])
  approvedById        String?        @map("approved_by_id")
  approvedBy          Participant?   @relation("ActivityApprover", fields: [approvedById], references: [id])
  approvedAt          DateTime?      @map("approved_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  responsibles     ActivityResponsible[]
  tasks            ActivityTask[]
  budget           ActivityBudget?
  approvalRequests ApprovalRequest[]
  history          ActivityHistory[]

  @@index([approvalStatus])
  @@index([date])
  @@index([teamId])
  @@index([statusId])
  @@map("activities")
}

model ActivityResponsible {
  id            String          @id @default(uuid())
  activityId    String          @map("activity_id")
  activity      Activity        @relation(fields: [activityId], references: [id], onDelete: Cascade)
  participantId String          @map("participant_id")
  participant   Participant     @relation(fields: [participantId], references: [id])
  type          ResponsibleType @default(SECONDARY)

  @@unique([activityId, participantId])
  @@index([participantId])
  @@map("activity_responsibles")
}

model ActivityTask {
  id            String       @id @default(uuid())
  activityId    String       @map("activity_id")
  activity      Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  name          String
  description   String?
  assigneeId    String?      @map("assignee_id")
  assignee      Participant? @relation("TaskAssignee", fields: [assigneeId], references: [id])
  dueDate       DateTime?    @map("due_date") @db.Date
  status        TaskStatus   @default(TODO)
  priority      TaskPriority @default(MEDIUM)
  completed     Boolean      @default(false)
  completedAt   DateTime?    @map("completed_at")
  completedById String?      @map("completed_by_id")
  completedBy   Participant? @relation("TaskCompleter", fields: [completedById], references: [id])
  position      Int          @default(0)
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([activityId])
  @@index([assigneeId])
  @@map("activity_tasks")
}

/// Historial de rondas de aprobación (soporta reaprobación futura).
model ApprovalRequest {
  id              String         @id @default(uuid())
  activityId      String         @map("activity_id")
  activity        Activity       @relation(fields: [activityId], references: [id], onDelete: Cascade)
  requestedById   String         @map("requested_by_id")
  requestedBy     Participant    @relation("ApprovalRequester", fields: [requestedById], references: [id])
  status          ApprovalStatus @default(PENDING)
  reviewedById    String?        @map("reviewed_by_id")
  reviewedBy      Participant?   @relation("ApprovalReviewer", fields: [reviewedById], references: [id])
  reviewedAt      DateTime?      @map("reviewed_at")
  comments        String?        @db.Text
  rejectionReason String?        @map("rejection_reason") @db.Text
  createdAt       DateTime       @default(now()) @map("created_at")

  @@index([activityId])
  @@index([status])
  @@map("approval_requests")
}

model ActivityBudget {
  id              String       @id @default(uuid())
  activityId      String       @unique @map("activity_id")
  activity        Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  requestedAmount Decimal      @default(0) @map("requested_amount") @db.Decimal(12, 2)
  approvedAmount  Decimal?     @map("approved_amount") @db.Decimal(12, 2)
  spentAmount     Decimal      @default(0) @map("spent_amount") @db.Decimal(12, 2)
  notes           String?      @db.Text
  createdAt       DateTime     @default(now()) @map("created_at")
  updatedAt       DateTime     @updatedAt @map("updated_at")
  items           BudgetItem[]

  @@map("activity_budgets")
}

model BudgetItem {
  id        String         @id @default(uuid())
  budgetId  String         @map("budget_id")
  budget    ActivityBudget @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  concept   String
  quantity  Decimal        @default(1) @db.Decimal(12, 2)
  unitPrice Decimal        @map("unit_price") @db.Decimal(12, 2)
  total     Decimal        @db.Decimal(12, 2)
  notes     String?
  position  Int            @default(0)

  @@index([budgetId])
  @@map("budget_items")
}

model ActivityHistory {
  id            String       @id @default(uuid())
  activityId    String       @map("activity_id")
  activity      Activity     @relation(fields: [activityId], references: [id], onDelete: Cascade)
  participantId String?      @map("participant_id")
  participant   Participant? @relation(fields: [participantId], references: [id])
  action        String
  oldValue      Json?        @map("old_value")
  newValue      Json?        @map("new_value")
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at")

  @@index([activityId])
  @@map("activity_history")
}

/// Stub para notificaciones (Fase 2); no se usa en MVP.
model Notification {
  id            String      @id @default(uuid())
  participantId String      @map("participant_id")
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)
  type          String
  title         String
  body          String?
  data          Json?
  readAt        DateTime?   @map("read_at")
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([participantId, readAt])
  @@map("notifications")
}
