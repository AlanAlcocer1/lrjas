DATABASE_URL="postgresql://lrjas:lrjas_secret@localhost:5432/lrjas?schema=public"
JWT_SECRET="lrjas_jwt_secret_change_in_production"
JWT_EXPIRES_IN="7d"
PORT=3001
FRONTEND_URL="http://localhost:5173"

# Cloudflare R2 — mismas vars que blog eca 360 (Coolify)
# STORAGE_BACKEND=r2
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=lrjas-media
# R2_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# R2_PUBLIC_BASE_URL=https://pub-xxxxx.r2.dev
# Carpeta dentro del bucket (opcional). Ej: lrjas → lrjas/images/anniversary/...
# R2_PREFIX=
# WEBP_QUALITY=85

# WalletWallet (pases Apple/Google). Sin key, generar pase falla con 503.
WALLETWALLET_API_KEY=""
# Imágenes Pro (opcional). Solo HTTPS o data:image/png;base64,…
# Por defecto el backend embebe assets/wallet/isotipo-verde.png e imagotipo-verde.png.
# WALLET_PASS_LOGO_URL="https://lrjasmerida.me/images/LRJAS%20Isotipo%20verde.png"
# WALLET_PASS_WIDE_LOGO_URL="https://lrjasmerida.me/images/LRJAS%20Imagotipo%20verde.png"
# WALLET_PASS_ICON_URL="https://lrjasmerida.me/images/LRJAS%20Isotipo%20verde.png"

# Usuario maestro (solo se crea si no hay admins en la BD)
MASTER_USER_USERNAME="alan"
MASTER_USER_NAME="Alan"
MASTER_USER_PASSWORD="Alan2908$"

# Consola SQL en admin (opcional, separados por coma). Siempre incluye MASTER_USER_USERNAME, alan y 000.
# DEV_CONSOLE_USERNAMES="000,alan"
